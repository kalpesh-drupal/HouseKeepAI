# Local Docker Postgres (docker compose up -d)
DATABASE_URL="postgresql://housekeep:housekeep@localhost:5432/housekeepai?schema=public"

# Railway: paste the Postgres DATABASE_URL from the Railway database service.
# Put that value in Vercel Environment Variables. Do not commit it.

# HouseKeepAI local port — permanent for this app only
PORT=3006
NEXTAUTH_URL="http://localhost:3006"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Protects /api/pms/cron scheduled sync endpoint
CRON_SECRET="replace-with-cron-secret"

# Optional: auto-sync interval hint for operators (minutes)
PMS_DEFAULT_SYNC_MINUTES=10
# SkyTouch Playwright agent — host on Railway/Docker (not Vercel). See docs/PMS-AGENT.md
# npm run pms:agent:loop
# PMS_AGENT_TICK_MS=60000
# Split workers by PMS, then by hotel slot (hash(hotelId) % SLOTS == SLOT).
# PMS_AGENT_PROVIDERS=SKYTOUCH
# PMS_AGENT_SLOTS=4
# PMS_AGENT_SLOT=0
# PLAYWRIGHT_DOCKER=1
# PLAYWRIGHT_ALLOW_SERVERLESS=1
# Local only: open a visible Chrome window during Collect (optional slowMo ms)
# PLAYWRIGHT_HEADED=1
# PLAYWRIGHT_SLOW_MO=150


# Encrypts PMS portal passwords at rest (AES-256-GCM). Falls back to NEXTAUTH_SECRET if unset.
# Generate with: openssl rand -base64 32
# PMS_CREDENTIALS_KEY=

# Optional: OpenAI for richer AI answers (falls back to rule-based without this)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
