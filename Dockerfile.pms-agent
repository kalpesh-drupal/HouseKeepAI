# SkyTouch PMS agent — always-on Firefox worker (not for Vercel).
# Deploy as a Railway / Fly / Render worker with production DATABASE_URL.
# Playwright version must match package-lock.json (currently 1.64.1).
FROM mcr.microsoft.com/playwright:v1.64.1-jammy

WORKDIR /app

# Install with devDependencies so prisma generate + esbuild work; set NODE_ENV after.
ENV PLAYWRIGHT_DOCKER=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PMS_AGENT_TICK_MS=60000

COPY package.json package-lock.json ./
COPY prisma ./prisma

RUN npm ci && npx prisma generate

COPY tsconfig.json ./
COPY scripts ./scripts
COPY src ./src

# Bundle to plain Node — avoids tsx runtime crashes on Railway.
RUN npm run pms:agent:build

ENV NODE_ENV=production

# npm as PID 1 never reaps Firefox's dead child processes (forkserver, Socket,
# RDD, Utility). Railway allows 1000 processes per container. Those leftovers
# fill the cap and the next Firefox cannot start, even when RAM is still free.
# tini is PID 1 and reaps them.
ADD https://github.com/krallin/tini/releases/download/v0.19.0/tini-amd64 /usr/bin/tini
RUN chmod +x /usr/bin/tini
ENTRYPOINT ["/usr/bin/tini", "--"]

# Railway injects PORT; the worker serves a tiny / health response so checks pass.
CMD ["npm", "run", "pms:agent:start"]
