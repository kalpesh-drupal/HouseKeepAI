{
  "expo": {
    "name": "HouseKeepAI",
    "slug": "housekeep-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "housekeepai",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B3A5B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.housekeepai.app",
      "infoPlist": {
        "CFBundleDisplayName": "HouseKeepAI",
        "NSCameraUsageDescription": "HouseKeepAI uses the camera for room photos and inspection evidence.",
        "NSPhotoLibraryUsageDescription": "HouseKeepAI lets staff attach room and maintenance photos from the library.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.housekeepai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B3A5B"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "ed131e53-9683-44f1-b607-e6e1cafe19e6"
      }
    },
    "owner": "kpatel26"
  }
}
