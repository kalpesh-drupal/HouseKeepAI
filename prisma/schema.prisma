generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  GENERAL_MANAGER
  FRONT_DESK
  EXECUTIVE_HOUSEKEEPER
  HOUSEKEEPER
  MAINTENANCE
  INSPECTOR
}

enum RoomStatus {
  VACANT_DIRTY
  CLEANING
  READY_TO_INSPECT
  VACANT_CLEAN
  INSPECTED
  OCCUPIED
  MAINTENANCE
  OUT_OF_ORDER
  OUT_OF_INVENTORY
}

enum GuestStayStatus {
  VACANT
  OCCUPIED
  DEPARTING
  STAYOVER
  ARRIVING
  CHECKED_OUT
  MAINTENANCE
}

enum CleaningStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_INSPECTION
  INSPECTION_FAILED
}

enum CleaningOutcome {
  CLEAN
  READY_TO_INSPECT
  UNFINISHED
  RESTARTED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  ASSIGNED
  WORKING
  WAITING_PARTS
  COMPLETED
}

enum InspectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GuestRequestStatus {
  OPEN
  ASSIGNED
  COMPLETED
}

enum MessageChannel {
  FRONT_DESK_HOUSEKEEPING
  MAINTENANCE_MANAGER
  INSPECTOR_HOUSEKEEPER
  GENERAL
}

enum StockAlertLevel {
  OK
  LOW
  CRITICAL
  REORDER
}

enum LaundryStatus {
  DIRTY
  WASHING
  DRYING
  READY
  DELIVERED
}

enum LostFoundStatus {
  STORED
  CLAIMED
  DISPOSED
}

enum PmsProvider {
  SKYTOUCH
  SYNXIS
  OPERA
  CLOUDBEDS
  MEWS
  STAYNTOUCH
  AUTOCLERK
  LITTLE_HOTELIER
}

enum PmsSyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum PmsWriteJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

/// SkyTouch Housekeeping Center condition to set on write-back.
enum PmsBoardCondition {
  READY
  CLEAN
  DIRTY
}

model Hotel {
  id        String   @id @default(cuid())
  name      String
  floors    Int      @default(3)
  /// PMS whose housekeeping report this hotel uploads (SkyTouch, Choice Advantage, …).
  reportPms String?
  /// IANA timezone used to close the hotel day at 3:00 AM.
  timezone     String    @default("America/Chicago")
  /// Business date currently open. The previous day is saved at 3:00 AM.
  businessDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  rooms              Room[]
  maintenanceTickets MaintenanceTicket[]
  guestRequests      GuestRequest[]
  messages           Message[]
  inventoryItems     InventoryItem[]
  laundryBatches     LaundryBatch[]
  lostFoundItems     LostFoundItem[]
  pmsConnections     PmsConnection[]
  pmsSyncLogs        PmsSyncLog[]
  pmsFlashSnapshots  PmsFlashSnapshot[]
  pmsWriteJobs       PmsWriteJob[]
  roomDaySnapshots   RoomDaySnapshot[]
  cleaningSessions   CleaningSession[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  active       Boolean  @default(true)
  hotelId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotel              Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  assignedRooms      Room[]              @relation("AssignedHousekeeper")
  inspectedRooms     Room[]              @relation("AssignedInspector")
  maintenanceTickets MaintenanceTicket[] @relation("AssignedTechnician")
  inspections        Inspection[]
  sentMessages       Message[]           @relation("SentMessages")
  receivedMessages   Message[]           @relation("ReceivedMessages")
  foundItems         LostFoundItem[]     @relation("FoundBy")
  assignedRequests   GuestRequest[]      @relation("AssignedRequests")
  cleaningSessions   CleaningSession[]   @relation("CleaningSessions")
  pushSubscriptions  PushSubscription[]
  passwordResetRequests PasswordResetRequest[]

  @@index([hotelId, active, role])
}

model PasswordResetRequest {
  id         String   @id @default(cuid())
  userId     String
  hotelId    String
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hotelId, resolvedAt])
  @@index([userId, createdAt])
}

model Room {
  id              String         @id @default(cuid())
  number          String
  floor           Int
  type            String         @default("Standard")
  status          RoomStatus     @default(VACANT_DIRTY)
  guestStatus     GuestStayStatus @default(VACANT)
  cleaningStatus  CleaningStatus @default(NOT_STARTED)
  isVip           Boolean        @default(false)
  isRush          Boolean        @default(false)
  doNotDisturb    Boolean        @default(false)
  guestName       String?
  arrivalDate     DateTime?
  departureDate   DateTime?
  guestNotes      String?
  frontDeskNotes  String?
  estimatedMinutes Int           @default(30)
  priority        Int            @default(0)
  manualLock      Boolean        @default(false)
  cleaningStartedAt DateTime?
  hotelId         String
  housekeeperId   String?
  inspectorId     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  hotel              Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  housekeeper        User?               @relation("AssignedHousekeeper", fields: [housekeeperId], references: [id])
  inspector          User?               @relation("AssignedInspector", fields: [inspectorId], references: [id])
  checklistItems     ChecklistItem[]
  inspections        Inspection[]
  maintenanceTickets MaintenanceTicket[]
  guestRequests      GuestRequest[]
  photos             RoomPhoto[]
  daySnapshots       RoomDaySnapshot[]
  cleaningSessions   CleaningSession[]

  @@unique([hotelId, number])
  @@index([hotelId, status])
  @@index([hotelId, housekeeperId])
  @@index([hotelId, floor, number])
  @@index([hotelId, arrivalDate])
  @@index([hotelId, departureDate])
  @@index([hotelId, isRush])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  roomId    String
  label     String
  completed Boolean  @default(false)
  needsAttention Boolean @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, sortOrder])
}

model Inspection {
  id          String           @id @default(cuid())
  roomId      String
  inspectorId String
  status      InspectionStatus @default(PENDING)
  score       Int?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  room      Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inspector User @relation(fields: [inspectorId], references: [id])
  items     InspectionItem[]

  @@index([roomId, createdAt])
  @@index([roomId, status])
  @@index([inspectorId, createdAt])
  @@index([status, createdAt])
}

model InspectionItem {
  id           String  @id @default(cuid())
  inspectionId String
  label        String
  passed       Boolean @default(false)
  sortOrder    Int     @default(0)

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId, sortOrder])
}

model MaintenanceTicket {
  id           String         @id @default(cuid())
  roomId       String
  hotelId      String
  title        String
  description  String?
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  photoUrl     String?
  assignedToId String?
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  room       Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hotel      Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("AssignedTechnician", fields: [assignedToId], references: [id])

  @@index([hotelId, status, createdAt])
  @@index([hotelId, createdAt])
  @@index([roomId, createdAt])
  @@index([assignedToId])
}

model GuestRequest {
  id           String             @id @default(cuid())
  roomId       String
  hotelId      String
  type         String
  status       GuestRequestStatus @default(OPEN)
  notes        String?
  assignedToId String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  room       Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hotel      Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("AssignedRequests", fields: [assignedToId], references: [id])

  @@index([hotelId, status, createdAt])
  @@index([hotelId, createdAt])
  @@index([roomId, createdAt])
  @@index([assignedToId])
}

model InventoryItem {
  id                String          @id @default(cuid())
  hotelId           String
  category          String
  quantity          Int             @default(0)
  reorderThreshold  Int             @default(20)
  criticalThreshold Int             @default(10)
  usagePerClean     Int             @default(1)
  unit              String          @default("units")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, category])
}

model LaundryBatch {
  id        String        @id @default(cuid())
  hotelId   String
  itemType  String
  quantity  Int           @default(0)
  status    LaundryStatus @default(DIRTY)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, status])
}

model LostFoundItem {
  id          String          @id @default(cuid())
  hotelId     String
  roomNumber  String?
  guestName   String?
  foundById   String?
  description String
  storageBin  String?
  photoUrl    String?
  status      LostFoundStatus @default(STORED)
  foundAt     DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  hotel   Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  foundBy User? @relation("FoundBy", fields: [foundById], references: [id])

  @@index([hotelId, status, createdAt])
  @@index([hotelId, createdAt])
}

model Message {
  id         String         @id @default(cuid())
  hotelId    String
  senderId   String
  receiverId String?
  channel    MessageChannel @default(GENERAL)
  content    String
  roomId     String?
  read       Boolean        @default(false)
  createdAt  DateTime       @default(now())

  hotel    Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  sender   User  @relation("SentMessages", fields: [senderId], references: [id])
  receiver User? @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([hotelId, createdAt])
  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
}

model RoomPhoto {
  id        String   @id @default(cuid())
  roomId    String
  url       String
  caption   String?
  type      String   @default("general")
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model PmsConnection {
  id                   String      @id @default(cuid())
  hotelId              String
  provider             PmsProvider
  propertyId           String?
  apiKey               String?
  apiSecret            String?
  baseUrl              String?
  enabled              Boolean     @default(false)
  syncIntervalMinutes  Int         @default(10)
  conflictPolicy       String      @default("PMS_RESERVATIONS_ONLY")
  lastSyncAt           DateTime?
  /// Secure portal login (no API). Password is AES-GCM encrypted at rest.
  portalEnabled        Boolean     @default(false)
  portalLoginUrl       String?
  portalUsername       String?
  portalPasswordEnc    String?
  /// Optional JSON overrides for login / report download selectors.
  portalSelectors      String?
  /// Playwright storageState (encrypted) — SynXis "Remember me" ~3 days.
  portalSessionEnc     String?     @db.Text
  portalSessionAt      DateTime?
  /// IMAP inbox used to read SynXis / Duo email OTP when session expires.
  portalImapHost       String?
  portalImapPort       Int         @default(993)
  portalImapUser       String?
  portalImapPasswordEnc String?
  portalImapMailbox    String?     @default("INBOX")
  /// Latest SkyTouch Welcome/Home flash stats (occupancy, ADR, arrivals, etc.).
  portalFlashJson      String?
  portalFlashAt        DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, provider])
  @@index([portalEnabled])
  @@index([enabled])
}

model PmsSyncLog {
  id        String        @id @default(cuid())
  hotelId   String
  provider  PmsProvider
  action    String
  records   Int           @default(0)
  status    PmsSyncStatus @default(SUCCESS)
  message   String?
  createdAt DateTime      @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, createdAt])
  @@index([hotelId, provider, createdAt])
}

/// Queue of SkyTouch Housekeeping Center write-backs (clean / ready / dirty).
model PmsWriteJob {
  id              String            @id @default(cuid())
  hotelId         String
  provider        PmsProvider       @default(SKYTOUCH)
  roomId          String?
  roomNumber      String
  condition       PmsBoardCondition
  status          PmsWriteJobStatus @default(PENDING)
  attempts        Int               @default(0)
  lastError       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  completedAt     DateTime?

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, status, createdAt])
  @@index([status, createdAt])
}

/// One row per SkyTouch (or other PMS) Home/Welcome flash collect.
model PmsFlashSnapshot {
  id                    String      @id @default(cuid())
  hotelId               String
  provider              PmsProvider
  collectedAt           DateTime
  sourceUrl             String?
  occupancyPercent      Float?
  expectedAdr           Float?
  totalArrivals         Int?
  checkInsCompleted     Int?
  checkInsRemaining     Int?
  totalDepartures       Int?
  vacantDirtyRemaining  Int?
  totalRoomsAvailable   Int?
  checkIns              Int?
  stayovers             Int?
  vacant                Int?
  ooo                   Int?
  available             Int?
  /// SynXis SPH Dashboard extras (optional for other PMS).
  preArrivals           Int?
  dayUse                Int?
  checkedOut            Int?
  vacantClean           Int?
  vacantDirty           Int?
  occupiedClean         Int?
  occupiedDirty         Int?
  outOfInventory        Int?
  createdAt             DateTime    @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, collectedAt])
  @@index([hotelId, provider, collectedAt])
}

/// End-of-day copy of each room, written at 3:00 AM hotel time.
model RoomDaySnapshot {
  id              String          @id @default(cuid())
  hotelId         String
  roomId          String
  roomNumber      String
  businessDate    DateTime
  status          RoomStatus
  guestStatus     GuestStayStatus
  cleaningStatus  CleaningStatus
  housekeeperId   String?
  housekeeperName String?
  doNotDisturb    Boolean         @default(false)
  isRush          Boolean         @default(false)
  isVip           Boolean         @default(false)
  arrivalDate     DateTime?
  departureDate   DateTime?
  frontDeskNotes  String?
  createdAt       DateTime        @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, businessDate])
  @@index([hotelId, businessDate])
  @@index([hotelId, housekeeperId, businessDate])
}

/// One housekeeper clean, from start to finish, kept for day, month, and year reports.
model CleaningSession {
  id              String            @id @default(cuid())
  hotelId         String
  roomId          String
  roomNumber      String
  housekeeperId   String?
  housekeeperName String?
  businessDate    DateTime
  startedAt       DateTime
  finishedAt      DateTime?
  durationSeconds Int?
  outcome         CleaningOutcome?
  createdAt       DateTime          @default(now())

  hotel       Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room        Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  housekeeper User? @relation("CleaningSessions", fields: [housekeeperId], references: [id], onDelete: SetNull)

  @@index([hotelId, businessDate])
  @@index([hotelId, housekeeperId, businessDate])
  @@index([roomId, finishedAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
